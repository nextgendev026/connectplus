{
  "name": "connectplus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "node prisma/seed.ts",
    "db:promote-admin": "node scripts/promote-superadmin.ts",
    "db:feed-mind": "node scripts/feed-the-mind.ts",
    "db:ensure": "ts-node --project scripts/tsconfig.script.json scripts/ensure-settings.ts",
    "cronjob:sync": "node scripts/cronjob-sync.mjs",
    "supabase:cron:install": "prisma db execute --file supabase/cron-maintenance.sql --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "vercel-build": "prisma migrate deploy && prisma generate && npm run db:ensure && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "autoprefixer": "^10.5.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "date-fns": "^4.1.0",
    "inngest": "^4.20.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "rss-parser": "^3.13.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
