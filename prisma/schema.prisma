generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String    @unique
  password      String
  avatar        String?
  coverImage    String?
  bio           String?
  role          String    @default("USER")
  isVerified    Boolean   @default(false)
  node          String?
  emailVerified DateTime?
  emailToken    String?
  emailTokenExpires DateTime?
  writerApplication WriterApplication?
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  followersLinks Follow[] @relation("FollowerLinks")
  followingLinks Follow[] @relation("FollowingLinks")
  moderationLogs ModerationLog[]
  conversations NeuralConversation[]
  notifications Notification[] @relation("NotifRecipient")
  sentNotifications Notification[] @relation("NotifActor")
  preference  UserPreference?
  feedback    ModelFeedback[]
  subscriptions UserSubscription[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([username])
  @@index([email])
}

/// Verified-writer applications. Users apply; admins approve (role -> CREATOR,
/// isVerified -> true) or reject (allowing re-application).
model WriterApplication {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivation  String     @db.Text
  portfolio   String?    @db.Text
  status      String     @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt  DateTime?
  reviewedNote String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  coverImage    String?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?
  tags          Tag[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  moderationLogs ModerationLog[]
  viewCount     Int       @default(0)
  status        String    @default("DRAFT")
  featured      Boolean   @default(false)
  moderationStatus String @default("PENDING")
  source        String?
  sourceUrl     String?
  moderatedAt  DateTime?
  moderatedBy  String?
  aiScore      Float?
  aiFlags      String?
  publishedAt  DateTime?
  scheduledAt  DateTime?
  notifications Notification[]
  postEmbedding PostEmbedding?
  feedback    ModelFeedback[]
  seoMetadata  SeoMetadata?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@index([categoryId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     Like[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@index([slug])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String?
  posts Post[]

  @@index([slug])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowingLinks", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowerLinks", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model ModerationLog {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  moderatorId String
  moderator User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  action    String
  reason    String?
  aiScore   Float?
  aiFlags   String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([moderatorId])
}

model PageView {
  id        String   @id @default(cuid())
  postId    String?
  path      String
  userAgent String?
  ip        String?
  country   String?
  city      String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([country])
  @@index([path, createdAt])
}

model RssFeed {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  siteUrl     String?
  description String?
  category    String?
  icon        String?
  isActive    Boolean  @default(true)
  lastPolled  DateTime?
  pollInterval Int     @default(3600)
  /// Fetch health, surfaced in the admin console so a dead or throttled feed
  /// is visible instead of silently importing nothing.
  lastStatus          String? // OK | EMPTY | HTTP_ERROR | PARSE_ERROR | TIMEOUT | SKIPPED
  lastError           String?
  lastItemCount       Int?
  lastNewArticles     Int?
  lastDurationMs      Int?
  consecutiveFailures Int     @default(0)
  /// Conditional-GET validators: sending these back avoids re-downloading an
  /// unchanged feed (the single biggest egress saver on a polling pipeline).
  httpEtag         String?
  httpLastModified String?
  articles    RssArticle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RssArticle {
  id          String   @id @default(cuid())
  feedId      String
  feed        RssFeed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  title       String
  url         String   @unique
  content     String?
  summary     String?
  author      String?
  imageUrl    String?
  publishedAt DateTime?
  importedAt  DateTime @default(now())
  postId      String?

  @@index([feedId])
  @@index([publishedAt])
}

/// Manually-injected advertising. Admins create creatives in the console and
/// the app renders the best match for each slot — no third-party script, no
/// client-side auction, so it costs no egress beyond the creative itself.
model Ad {
  id          String    @id @default(cuid())
  name        String
  /// Placement key: feed-inline | article-top | article-inline | article-sidebar | radio-hero
  slot        String    @default("feed-inline")
  /// image = trackable click-through; html = raw embed (network scripts)
  format      String    @default("image")
  imageUrl    String?
  html        String?
  targetUrl   String?
  sponsor     String?
  /// Higher weight wins more often when several ads share a slot.
  weight      Int       @default(1)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slot, isActive])
}

/// Key-value platform settings powering the Admin Settings & Integrations
/// console (site identity, SEO, analytics integrations, API keys, feature
/// flags). Values are strings; booleans use "true"/"false".
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String   @default("general") // general | seo | integrations | plugins | api
  label     String?
  hint      String?
  type      String   @default("text")   // text | textarea | url | boolean | number | secret
  isPublic  Boolean  @default(false)    // exposed read-only via /api/settings/public
  isSecret  Boolean  @default(false)    // masked in the admin UI until revealed
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
}

model NeuralMemory {
  id           String    @id @default(cuid())
  source       String
  category     String
  content      String    @db.Text
  tags         String    @db.Text
  confidence   Float     @default(0.5)
  metadata     String?
  sourceUrl    String?
  sourceFeedId String?
  accessCount  Int       @default(0)
  lastAccessedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([source])
  @@index([category])
  @@index([tags])
}

model NeuralConversation {
  id        String           @id @default(cuid())
  title     String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  NeuralMessage[]

  @@index([userId])
}

model NeuralMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   NeuralConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  intent         String?
  enginesUsed    String?
  metadata       String?
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String?
  message   String?
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Semantic embedding of a post's content. `vector`/`titleVec` are JSON arrays
/// (portable, used as source of truth); `pgVec` mirrors `vector` as a real
/// pgvector column for indexed cosine search on hosts with the extension.
model PostEmbedding {
  id       String   @id @default(cuid())
  postId   String   @unique
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  vector   String   @db.Text // JSON array of floats, EMBEDDING_DIM length
  dim      Int      @default(384)
  model    String   @default("hash-minilm")
  titleVec String?  @db.Text // JSON embedding of title only (for title matching)
  pgVec    Unsupported("vector(384)")? // pgvector mirror of vector (Phase 0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

/// Aggregated per-user preferences learned from interaction feedback.
model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector       String   @db.Text // averaged embedding of liked/saved posts
  tagVector    String   @db.Text // JSON map tag -> affinity weight
  categoryCount String  @db.Text // JSON map categoryId -> weight
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Raw interaction feedback used by the learning loop (Phase 3).
model ModelFeedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  type      String   // impression | click | like | bookmark | share | time_spent | comment
  value     Float?   // e.g. seconds for time_spent, 1 for like
  variant   String?  // A/B experiment variant active when the event was logged
  sessionId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([postId])
  @@index([type])
  @@index([createdAt])
  @@index([variant])
}

/// Subscription plans — 3 tiers for both readers and writers.
model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "reader-free", "reader-pro", "writer-pro"
  displayName   String   // "Free Reader", "Pro Reader", "Pro Writer"
  tier          String   // free | pro | premium
  audience      String   // reader | writer
  priceMonthly  Float    @default(0)
  priceYearly   Float    @default(0)
  currency      String   @default("USD")
  features      String   @db.Text // JSON array of feature strings
  limits        String   @db.Text // JSON object: { postsPerMonth, storageMb, aiRequests, ... }
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions UserSubscription[]

  @@index([tier, audience])
}

/// Active user subscriptions.
model UserSubscription {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
  status          String            @default("active") // active | cancelled | past_due | trialing
  billingCycle    String            @default("monthly") // monthly | yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean         @default(false)
  stripeSubscriptionId String?
  stripeCustomerId    String?
  usageThisPeriod     Int             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, planId])
  @@index([userId])
  @@index([status])
}

/// Third-party ad slot configuration — allows admins to inject Google AdSense,
/// Facebook Audience Network, or custom ad scripts into specific placements.
model ThirdPartyAdSlot {
  id          String   @id @default(cuid())
  name        String   @unique // "sidebar-banner", "article-bottom", etc.
  slot        String   // matches Ad.slot: feed-inline | article-top | article-inline | article-sidebar | radio-hero
  provider    String   // adsense | facebook | custom | mgid | propeller
  scriptTag   String?  @db.Text // full <script> or <ins> tag to inject
  adUnitId    String?  // e.g. ca-pub-XXXXXXXX or ad placement ID
  sizes       String?  // JSON array of ad sizes [[300,250],[728,90]]
  isActive    Boolean  @default(true)
  weight      Int      @default(1)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot, isActive])
}

/// SEO: article-level structured data and metadata overrides.
model SeoMetadata {
  id            String  @id @default(cuid())
  postId        String  @unique
  post          Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  canonicalUrl  String?
  noIndex       Boolean @default(false)
  jsonLd        String? @db.Text // custom JSON-LD overrides
  customOgTitle String?
  customOgDesc  String?
  customOgImage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
