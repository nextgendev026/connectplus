generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String    @unique
  password      String
  avatar        String?
  coverImage    String?
  bio           String?
  role          String    @default("USER")
  isVerified    Boolean   @default(false)
  node          String?
  emailVerified DateTime?
  emailToken    String?
  emailTokenExpires DateTime?
  writerApplication WriterApplication?
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  followersLinks Follow[] @relation("FollowerLinks")
  followingLinks Follow[] @relation("FollowingLinks")
  moderationLogs ModerationLog[]
  conversations NeuralConversation[]
  notifications Notification[] @relation("NotifRecipient")
  sentNotifications Notification[] @relation("NotifActor")
  pushSubscriptions PushSubscription[]
  preference  UserPreference?
  feedback    ModelFeedback[]
  subscriptions UserSubscription[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([username])
  @@index([email])
}

/// Verified-writer applications. Users apply; admins approve (role -> CREATOR,
/// isVerified -> true) or reject (allowing re-application).
model WriterApplication {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivation  String     @db.Text
  portfolio   String?    @db.Text
  status      String     @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt  DateTime?
  reviewedNote String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  coverImage    String?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?
  tags          Tag[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  moderationLogs ModerationLog[]
  viewCount     Int       @default(0)
  status        String    @default("DRAFT")
  featured      Boolean   @default(false)
  moderationStatus String @default("PENDING")
  source        String?
  sourceUrl     String?
  moderatedAt  DateTime?
  moderatedBy  String?
  aiScore      Float?
  aiFlags      String?
  publishedAt  DateTime?
  scheduledAt  DateTime?
  notifications Notification[]
  postEmbedding PostEmbedding?
  feedback    ModelFeedback[]
  seoMetadata  SeoMetadata?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@index([categoryId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     Like[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@index([slug])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String?
  posts Post[]

  @@index([slug])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowingLinks", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowerLinks", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model ModerationLog {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  moderatorId String
  moderator User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  action    String
  reason    String?
  aiScore   Float?
  aiFlags   String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([moderatorId])
}

/// Page-level traffic. One row per view; `visitorHash` is a salted, non-
/// reversible hash of a first-party cookie, so unique visitors can be counted
/// WITHOUT storing a raw IP or any identifier that maps back to a person.
model PageView {
  id        String   @id @default(cuid())
  postId    String?
  path      String
  /// Salted hash of the visitor cookie — the unit of "unique visitor".
  visitorHash String?
  /// Coarse session bucket (visitorHash + hour) so sessions can be counted
  /// without a second table.
  sessionKey  String?
  userId    String?
  userAgent String?
  ip        String?
  country   String?
  city      String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([country])
  @@index([path, createdAt])
  @@index([visitorHash, createdAt])
  @@index([createdAt])
}

model RssFeed {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  siteUrl     String?
  description String?
  category    String?
  icon        String?
  isActive    Boolean  @default(true)
  lastPolled  DateTime?
  pollInterval Int     @default(3600)
  /// Fetch health, surfaced in the admin console so a dead or throttled feed
  /// is visible instead of silently importing nothing.
  lastStatus          String? // OK | EMPTY | HTTP_ERROR | PARSE_ERROR | TIMEOUT | SKIPPED
  lastError           String?
  lastItemCount       Int?
  lastNewArticles     Int?
  lastDurationMs      Int?
  consecutiveFailures Int     @default(0)
  /// Intake verdicts for the last poll, as a JSON object of reason -> count.
  /// This is the "items filtered by reason" column in the feed health view.
  lastFiltered        String? @db.Text
  /// Items the moderation scanner flagged for review on the last poll.
  lastFlagged         Int?
  /// Imported items per category slug on the last poll (JSON object).
  lastCategories      String? @db.Text
  /// Conditional-GET validators: sending these back avoids re-downloading an
  /// unchanged feed (the single biggest egress saver on a polling pipeline).
  httpEtag         String?
  httpLastModified String?
  articles    RssArticle[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RssArticle {
  id          String   @id @default(cuid())
  feedId      String
  feed        RssFeed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  title       String
  url         String   @unique
  content     String?
  summary     String?
  author      String?
  imageUrl    String?
  publishedAt DateTime?
  importedAt  DateTime @default(now())
  postId      String?

  @@index([feedId])
  @@index([publishedAt])
}

/// Manually-injected advertising. Admins create creatives in the console and
/// the app renders the best match for each slot — no third-party script, no
/// client-side auction, so it costs no egress beyond the creative itself.
model Ad {
  id          String    @id @default(cuid())
  name        String
  /// Placement key: feed-inline | article-top | article-inline | article-sidebar | radio-hero
  slot        String    @default("feed-inline")
  /// image = trackable click-through; html = raw embed (network scripts)
  format      String    @default("image")
  imageUrl    String?
  html        String?
  targetUrl   String?
  sponsor     String?
  /// Higher weight wins more often when several ads share a slot.
  weight      Int       @default(1)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slot, isActive])
}

/// Key-value platform settings powering the Admin Settings & Integrations
/// console (site identity, SEO, analytics integrations, API keys, feature
/// flags). Values are strings; booleans use "true"/"false".
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  group     String   @default("general") // general | seo | integrations | plugins | api
  label     String?
  hint      String?
  type      String   @default("text")   // text | textarea | url | boolean | number | secret
  isPublic  Boolean  @default(false)    // exposed read-only via /api/settings/public
  isSecret  Boolean  @default(false)    // masked in the admin UI until revealed
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group])
}

model NeuralMemory {
  id           String    @id @default(cuid())
  source       String
  category     String
  content      String    @db.Text
  tags         String    @db.Text
  confidence   Float     @default(0.5)
  metadata     String?
  sourceUrl    String?
  sourceFeedId String?
  accessCount  Int       @default(0)
  lastAccessedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([source])
  @@index([category])
  @@index([tags])
}

model NeuralConversation {
  id        String           @id @default(cuid())
  title     String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  NeuralMessage[]

  @@index([userId])
}

model NeuralMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   NeuralConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  intent         String?
  enginesUsed    String?
  metadata       String?
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

/// One push endpoint per browser/device.
///
/// This used to be a JSON array inside a single PlatformSetting row, which made
/// subscribing a read-modify-write across every device: two subscribers at once
/// silently lost one of the registrations, the blob grew without bound, and a
/// dead endpoint could never be pruned because nothing identified it on its own.
/// A row per endpoint makes each of those a one-line operation.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The push service URL. Unique: an endpoint belongs to exactly one device,
  /// and re-registering it must rotate ownership rather than duplicate it.
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  /// Consecutive delivery failures. Pruned at 5 — a permanently-gone endpoint
  /// (410/404) or a repeatedly-refused one is dead weight on every send.
  failures   Int      @default(0)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([failures])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String?
  message   String?
  postId    String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Semantic embedding of a post's content. `vector`/`titleVec` are JSON arrays
/// (portable, used as source of truth); `pgVec` mirrors `vector` as a real
/// pgvector column for indexed cosine search on hosts with the extension.
model PostEmbedding {
  id       String   @id @default(cuid())
  postId   String   @unique
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  vector   String   @db.Text // JSON array of floats, EMBEDDING_DIM length
  dim      Int      @default(384)
  model    String   @default("hash-minilm")
  titleVec String?  @db.Text // JSON embedding of title only (for title matching)
  pgVec    Unsupported("vector(384)")? // pgvector mirror of vector (Phase 0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

/// Aggregated per-user preferences learned from interaction feedback.
model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vector       String   @db.Text // averaged embedding of liked/saved posts
  tagVector    String   @db.Text // JSON map tag -> affinity weight
  categoryCount String  @db.Text // JSON map categoryId -> weight
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Raw interaction feedback used by the learning loop (Phase 3).
model ModelFeedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  type      String   // impression | click | like | bookmark | share | time_spent | comment
  value     Float?   // e.g. seconds for time_spent, 1 for like
  variant   String?  // A/B experiment variant active when the event was logged
  sessionId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([postId])
  @@index([type])
  @@index([createdAt])
  @@index([variant])
}

/// Subscription plans — 3 tiers for both readers and writers.
model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "reader-free", "reader-pro", "writer-pro"
  displayName   String   // "Free Reader", "Pro Reader", "Pro Writer"
  tier          String   // free | pro | premium
  audience      String   // reader | writer
  priceMonthly  Float    @default(0)
  priceYearly   Float    @default(0)
  currency      String   @default("USD")
  features      String   @db.Text // JSON array of feature strings
  limits        String   @db.Text // JSON object: { postsPerMonth, storageMb, aiRequests, ... }
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Provider-side plan/product identifiers, per billing cycle. PayPal
  /// Subscriptions needs a product + plan pair to bill recurrently; when these
  /// are empty PayPal falls back to a one-off covered period (see
  /// src/lib/payments/paypal.ts). Daraja needs no identifier at all — it bills
  /// a one-off amount per cycle — so it never reads these.
  paypalPlanMonthlyId String?
  paypalPlanYearlyId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subscriptions UserSubscription[]

  @@index([tier, audience])
}

/// Active user subscriptions.
model UserSubscription {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
  status          String            @default("active") // active | cancelled | past_due | trialing
  billingCycle    String            @default("monthly") // monthly | yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean         @default(false)
  /// Which rail collected the money: daraja (M-Pesa) | paypal | manual
  /// (free grants, comps and admin adjustments).
  provider            String          @default("manual")
  /// Provider-side subscription id when the rail supports recurring billing
  /// (PayPal's `I-XXXXX`). M-Pesa has no subscription object, so its renewals
  /// are driven by our own period window and this stays null.
  providerSubscriptionId String?
  providerCustomerId     String?
  /// Last settled payment: the M-Pesa receipt number or the PayPal capture id,
  /// kept so a member's payment can always be pointed at from the admin
  /// console without a second lookup.
  lastPaymentRef      String?
  lastPaymentAt       DateTime?
  /// Payer MSISDN (2547XXXXXXXX) for M-Pesa members — the number the STK prompt
  /// was sent to, shown in the console when reconciling a payment.
  payerPhone          String?
  usageThisPeriod     Int             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, planId])
  @@index([userId])
  @@index([status])
}

/// One attempt to buy a paid plan — created *before* the reader is handed to a
/// payment provider.
///
/// This is the row every asynchronous rail reconciles against: PayPal returns
/// the reader with an order id, M-Pesa calls back with a CheckoutRequestID, and
/// both have to find something durable that says who was paying for what. It
/// also makes the inverse visible — a settled payment that matches no intent is
/// a replay or a mistake, and the admin console can say so instead of guessing.
model PaymentIntent {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  billingCycle String   @default("monthly") // monthly | yearly
  /// daraja | paypal
  provider     String
  /// Our own reference, sent to the provider (PayPal `custom_id`, Daraja
  /// `AccountReference`) and echoed back, so a callback is matched to an intent
  /// without trusting anything the caller claims.
  reference    String   @unique
  /// Amount actually charged, in the provider's settlement currency.
  amount       Float
  currency     String
  /// Amount the plan is priced at, in the plan's own currency, kept for display.
  listAmount   Float?
  listCurrency String?
  /// pending | processing | succeeded | failed | cancelled | expired
  status       String   @default("pending")
  /// PayPal: the hosted approval URL returned by createOrder.
  checkoutUrl     String? @db.Text
  /// PayPal order id (the handle used to capture).
  providerOrderId String?
  /// Daraja CheckoutRequestID (the handle used to query STK status).
  providerRequestId String?
  /// Settlement reference: M-Pesa receipt number or PayPal capture id.
  providerReceipt String?
  payerPhone      String?
  failureReason   String?
  /// Raw provider payload, kept for dispute/audit work.
  metadata        String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  settledAt       DateTime?

  @@index([userId, status])
  @@index([provider, status])
  @@index([providerOrderId])
  @@index([providerRequestId])
  @@index([createdAt])
}

/// Idempotency ledger for inbound payment notifications.
///
/// Both rails retry: PayPal redelivers a webhook until it gets a 2xx, and
/// Safaricom can deliver the same STK callback more than once. Claiming the
/// event id *before* running the handler (and treating the unique violation as
/// "already handled") is race-free, where a read-then-write would let two
/// concurrent deliveries double-extend a subscription.
model PaymentEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  provider  String
  type      String
  handledAt DateTime @default(now())

  @@index([provider, handledAt])
}

/// Third-party ad slot configuration — allows admins to inject Google AdSense,
/// Facebook Audience Network, or custom ad scripts into specific placements.
model ThirdPartyAdSlot {
  id          String   @id @default(cuid())
  name        String   @unique // "sidebar-banner", "article-bottom", etc.
  slot        String   // matches Ad.slot: feed-inline | article-top | article-inline | article-sidebar | radio-hero
  provider    String   // adsense | facebook | custom | mgid | propeller
  scriptTag   String?  @db.Text // full <script> or <ins> tag to inject
  adUnitId    String?  // e.g. ca-pub-XXXXXXXX or ad placement ID
  sizes       String?  // JSON array of ad sizes [[300,250],[728,90]]
  isActive    Boolean  @default(true)
  weight      Int      @default(1)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot, isActive])
}

/// SEO: article-level structured data and metadata overrides.
model SeoMetadata {
  id            String  @id @default(cuid())
  postId        String  @unique
  post          Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  canonicalUrl  String?
  noIndex       Boolean @default(false)
  jsonLd        String? @db.Text // custom JSON-LD overrides
  customOgTitle String?
  customOgDesc  String?
  customOgImage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Normalised livescore snapshot. Every provider adapter (football-data.org,
/// TheSportsDB, or the built-in demo feed) is mapped onto this ONE shape, so the
/// public page, the betting analyser and the hive mind never care where a
/// fixture came from. Rows are upserted by (provider, externalId) and kept after
/// full time so the analyser can grade its own predictions.
model SportsMatch {
  id            String   @id @default(cuid())
  externalId    String
  provider      String   @default("demo")
  sport         String   @default("football")
  competition   String
  competitionId String?
  country       String?
  homeTeam      String
  awayTeam      String
  homeScore     Int?
  awayScore     Int?
  /// SCHEDULED | LIVE | HT | FT | POSTPONED | CANCELLED | SUSPENDED
  status        String   @default("SCHEDULED")
  minute        Int?
  kickoff       DateTime?
  venue         String?
  homeForm      String?
  awayForm      String?
  /// Decimal 1X2 prices when the provider publishes them (for value edges).
  oddsHome      Float?
  oddsDraw      Float?
  oddsAway      Float?
  providerUpdatedAt DateTime?
  lastSyncedAt  DateTime @default(now())
  predictions   SportsPrediction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([status, kickoff])
  @@index([competition, kickoff])
  @@index([sport, kickoff])
}

/// A model-generated betting pick. Written by the sports intelligence layer
/// after it has folded the fixtures into neural memory, so every pick has a
/// rationale the admin console (and the hive) can inspect and learn from.
model SportsPrediction {
  id             String   @id @default(cuid())
  matchId        String
  match          SportsMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// 1X2 | double-chance | over-under | btts
  market         String   @default("1X2")
  selection      String
  confidence     Float    @default(0.5)
  homeWinPct     Float?
  drawPct        Float?
  awayWinPct     Float?
  expectedHomeGoals Float?
  expectedAwayGoals Float?
  /// Percentage points of edge over the provider's implied probability.
  valueEdge      Float?
  rationale      String   @db.Text
  model          String   @default("hive-hybrid")
  /// PENDING | WON | LOST | VOID
  status         String   @default("PENDING")
  settledAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One row per (fixture, market, model): the analyser runs from several
  /// triggers at once, so the write path must be idempotent rather than
  /// trusting an in-memory "does it exist yet" check (which races).
  @@unique([matchId, market, model])
  @@index([matchId])
  @@index([status])
  @@index([createdAt])
  @@index([market, status])
}

/// A reminder on ONE fixture ("notify me about this match"). Separate from
/// SportsTeamFollow because readers often care about a single game — a derby, a
/// final — without following either club permanently.
model SportsMatchReminder {
  id          String   @id @default(cuid())
  userId      String
  /// `${provider}:${externalId}` — stable across snapshot refreshes.
  matchKey    String
  provider    String
  externalId  String
  homeTeam    String
  awayTeam    String
  competition String
  kickoff     DateTime?
  /// KICKOFF | LIVE | GOAL | RED_CARD | SUB | FINAL | PICK_SETTLED
  events      String   @default("KICKOFF,LIVE,GOAL,RED_CARD,SUB,FINAL,PICK_SETTLED")
  createdAt   DateTime @default(now())

  @@unique([userId, matchKey])
  @@index([matchKey])
  @@index([userId])
}

/// Idempotency ledger: one row per (user, match, event) actually notified, so a
/// 2-minute poll can never send the same kick-off alert twice.
model SportsNotificationLog {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  event     String
  createdAt DateTime @default(now())

  @@unique([userId, matchId, event])
  @@index([createdAt])
  @@index([userId])
}

/// A reader's followed team. Used to filter the livescore feed to "my teams"
/// and to weight the model's attention; kept as a plain userId string (like
/// SportsActivity) so the table needs no cascade relationship.
model SportsTeamFollow {
  id          String   @id @default(cuid())
  userId      String
  team        String
  sport       String   @default("football")
  competition String?
  createdAt   DateTime @default(now())

  @@unique([userId, team])
  @@index([userId])
  @@index([team])
}

/// One whole-registry RSS drain. Rows outlive Redis, so "what happened last
/// time, per feed?" is answerable from the console instead of a progress bar
/// that disappears the moment the tab closes.
model RssDrainRun {
  id          String   @id @default(cuid())
  /// queued | running | done | cancelled
  stage       String   @default("queued")
  total       Int      @default(0)
  processed   Int      @default(0)
  newArticles Int      @default(0)
  errors      Int      @default(0)
  cancelled   Boolean  @default(false)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  feeds       RssDrainFeed[]

  @@index([startedAt])
}

/// Per-feed outcome inside a drain run — the durable history behind the feed
/// health view. Written as each Inngest step completes, so a crash still leaves
/// an auditable record of which feeds were reached.
model RssDrainFeed {
  id          String      @id @default(cuid())
  runId       String
  run         RssDrainRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  feedId      String?
  feedName    String
  status      String
  newArticles Int         @default(0)
  items       Int?
  durationMs  Int?
  error       String?     @db.Text
  createdAt   DateTime    @default(now())

  @@index([runId])
  @@index([feedId, createdAt])
}

/// Admin-injected betting partner. The referral code is woven into the URL
/// template at click time (never hard-coded in the page), and every impression,
/// click and conversion is counted so the console can rank partners.
model BettingReferral {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  region      String?
  /// Destination template. `{code}` is replaced with referralCode, `{match}`
  /// with the current match id when the link is opened from a fixture.
  urlTemplate String   @db.Text
  referralCode String?
  bonus       String?
  description String?  @db.Text
  logoUrl     String?
  /// sports-hero | sports-inline | sports-sidebar | sports-footer
  placement   String   @default("sports-sidebar")
  ctaText     String   @default("Join & claim")
  weight      Int      @default(1)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([placement, isActive])
}

/// Lightweight activity ledger for the sports hub. Impressions and clicks are
/// counted on the referral row as well; this table keeps the time series the
/// admin console charts (and the visitor/returning split) without a second
/// analytics pipeline.
model SportsActivity {
  id          String   @id @default(cuid())
  /// match_view | prediction_view | referral_impression | referral_click | prediction_settled
  type        String
  matchId     String?
  predictionId String?
  referralId  String?
  userId      String?
  visitorHash String?
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([referralId])
  @@index([matchId])
}
