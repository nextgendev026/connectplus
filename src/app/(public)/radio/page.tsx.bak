                    <div className="min-w-0">
                      <p className="text-sm font-medium text-surface-50 truncate">
                        {currentStation?.name}
                      </p>
                      <p className="text-[10px] text-surface-400 genre-badge">
                        {currentStation?.genre}
                      </p>
                    </div>
