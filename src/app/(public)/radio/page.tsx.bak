// Initialize AudioContext for better audio handling
const getAudioContext = (): AudioContext => {
  // @ts-ignore - AudioContext may not be available in all environments
  const globalObj = typeof window !== "undefined" ? window : {};
  return globalObj.AudioContext || (globalObj as any).webkitAudioContext || null;
};

// Create a persistent audio context for mini player
let sharedAudioContext: AudioContext | null = null;

function useAudioContext() {
  const [context, setContext] = useState<AudioContext | null>(null);

  useEffect(() => {
    if typeof window !== "undefined") {
      setContext(getAudioContext());
    }
  }, []);

  return context;
}

const MINI_PLAYER_STATE = {
  COLLAPSED: "collapsed",
  EXPANDED: "expanded",
  MINIMIZED: "minimized",
};

const GENRES = [
  "All",
  "Top 40 / Pop",
  "Classic Hits",
  "Urban / R&B",
