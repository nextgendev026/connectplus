# ConnectPlus Environment Variables
# Copy this file to .env and fill in the values

# Database (local dev defaults to SQLite; production uses Supabase Postgres)
# Local:    DATABASE_URL="file:./dev.db"
# Production (Supabase -> Connect -> Prisma / Connection string):
DATABASE_URL="postgresql://postgres.eligxvxirkfnqqkywxhv:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth.js
# Generate a secure secret: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Supabase (optional - used for file storage)
SUPABASE_URL="https://eligxvxirkfnqqkywxhv.supabase.co"
SUPABASE_ANON_KEY=""

# Upload settings
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760
