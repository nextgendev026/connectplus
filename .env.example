# ConnectPlus Environment Variables
# Copy this file to .env and fill in the values

# Database (local dev defaults to SQLite; production uses Supabase Postgres)
# Local:    DATABASE_URL="file:./dev.db"
# Production (Supabase -> Connect -> Prisma / Connection string):
DATABASE_URL="postgresql://postgres.sobouolsnvgksdjzpcsj:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection — used by migrations and for shadow DB:
DIRECT_URL="postgresql://postgres.sobouolsnvgksdjzpcsj:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Inngest
# Get your signing key from https://www.inngest.com/docs/signing-keys
# The signing key authenticates Inngest -> the app (/api/inngest); the event key
# authenticates the app -> Inngest when it publishes events itself (cron
# triggers, RSS drains, alerts). They are different keys; only the event key is
# needed for the app to enqueue work on its own.
INNGEST_SIGN_KEY=""
INNGEST_EVENT_KEY=""

# NextAuth.js
# Generate a secure secret: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Supabase (used for file storage)
SUPABASE_URL="https://sobouolsnvgksdjzpcsj.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Upload settings
UPLOAD_DIR="./public/uploads"
# Overall cap (bytes). Default 5MB. Per-type caps default: jpeg/png/webp 5MB, gif 8MB.
MAX_FILE_SIZE=5242880
# Optional per-type overrides (bytes), e.g.:
# MAX_GIF_SIZE=10485760
# MAX_JPEG_SIZE=8388608

# ── Payments: Safaricom Daraja (M-Pesa) + PayPal ────────────────────────────
# Two rails, because the audience is two audiences: a Kenyan handset paying by
# M-Pesa, and a card or PayPal balance anywhere else in the world. Stripe was
# removed — it does not serve East Africa, so every paid plan was unreachable.
#
# With neither rail configured the app still runs: free plans work, and the
# pricing page says payments are being connected instead of offering a button
# that fails. Admin → Payments shows exactly which variables are still missing.

# Safaricom Daraja — M-Pesa STK push (Lipa na M-Pesa).
#   MPESA_CONSUMER_KEY / MPESA_CONSUMER_SECRET — from https://developer.safaricom.co.ke/
#   MPESA_SHORTCODE   — your paybill or till number (sandbox test shortcode: 174379)
#   MPESA_PASSKEY     — the Lipa na M-Pesa passkey issued for that shortcode
#   MPESA_ENV         — "production" for live money; anything else = sandbox
#   MPESA_TRANSACTION_TYPE — CustomerPayBillOnline (paybill, default) or
#                            CustomerBuyGoodsOnline (till / Buy Goods)
#   MPESA_CALLBACK_URL — optional; defaults to <APP_URL>/api/payments/daraja/callback
#   MPESA_CALLBACK_TOKEN — optional shared secret appended to the callback URL.
#                        Safaricom does not sign callbacks, so this is a second
#                        gate in front of the CheckoutRequestID → intent match.
#   MPESA_CALLBACK_IP_CHECK=on — additionally enforce Safaricom's published source
#                        IP ranges (MPESA_ALLOWED_IPS overrides the built-in list)
#   MPESA_KES_PER_USD — rate used to price a USD plan on the M-Pesa rail
#                        (default 129). M-Pesa cannot settle a fraction of a
#                        shilling, so amounts are charged in whole KES.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENV="sandbox"
# MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# MPESA_CALLBACK_URL=""
# MPESA_CALLBACK_TOKEN=""
# MPESA_CALLBACK_IP_CHECK="off"
# MPESA_KES_PER_USD=129

# PayPal — cards and wallet, settled in USD (PayPal cannot settle KES).
#   PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET — from the PayPal developer dashboard
#   PAYPAL_WEBHOOK_ID — REQUIRED to accept webhooks. Without it the webhook route
#                       answers 503 rather than trusting an unverified POST,
#                       because an unverified webhook is just an anonymous
#                       request asking to be given a paid plan.
#   PAYPAL_ENV="live"  — production; anything else = sandbox
# Webhook URL to register: <APP_URL>/api/payments/paypal/webhook, subscribed to
# PAYMENT.CAPTURE.* and BILLING.SUBSCRIPTION.*.
# Per plan, an optional PayPal plan id (paypalPlanMonthlyId / paypalPlanYearlyId,
# set from Admin → Subscriptions) upgrades that plan to a true recurring
# subscription. Without one, members pay one period up front and renew
# deliberately — nothing auto-charges.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# Sports livescore hub (optional) — powers /sports live scores + betting intel.
# The hub is multi-source: it fans out to every configured feed and merges the
# fixtures, so one provider being throttled never empties the board. With no
# keys at all it still runs on real keyless feeds (TheSportsDB public key, ESPN,
# OpenLigaDB) instead of synthetic data.
#   SPORTS_PROVIDER=auto | football-data | sportsdb | espn | openligadb | demo
#   SPORTS_API_KEY   — football-data.org token (highest-priority source)
#   SPORTSDB_API_KEY — TheSportsDB key; defaults to their public test key "3"
#   SPORTS_KEYLESS=on|off — include the keyless tier (ESPN / OpenLigaDB)
#   SPORTS_API_BASE  — override the football-data base URL (default v4)
#   SPORTS_CACHE_TTL_SECONDS     — live snapshot cache, default 30
#   SPORTS_DAY_CACHE_TTL_SECONDS — past/future day cache, default 600
#   NEXT_PUBLIC_EDGE_URL — public URL of the Cloudflare edge worker. When set,
#     the live board polls <edge>/__livescore and every viewer's poll collapses
#     into one origin fetch per TTL window, with stale-serve-while-revalidate.
#     Leave empty to poll the app's own /api/sports/live route instead.
SPORTS_PROVIDER="auto"
SPORTS_API_KEY=""
SPORTSDB_API_KEY=""
SPORTS_KEYLESS="on"
SPORTS_API_BASE=""
NEXT_PUBLIC_EDGE_URL=""

# Image optimization
#
# The site no longer uses Vercel's image optimizer: every <Image> resolves
# through src/lib/image-loader.ts instead, because that optimizer is metered
# against a SEPARATE allowance from function invocations and is what exhausted.
#
# Empty (the default) = images are served from their origin untouched, and the
# Cloudflare edge worker caches them. Nothing touches Vercel compute, which is
# the point. The trade is that a third-party cover is delivered at its original
# size — our own uploads are already resized at upload time, so the heavy assets
# are unaffected.
#
# Set it to a Cloudflare zone origin to resize at the edge instead:
#   NEXT_PUBLIC_IMAGE_RESIZE_ORIGIN="https://cdn.yourdomain.com"
# This requires Cloudflare Image Resizing (a paid add-on) or Cloudflare Images.
# On a free Cloudflare plan /cdn-cgi/image/ returns an error; this loader then
# degrades images rather than breaking them, but the images WILL be wrong, so do
# not set it without confirming the entitlement is active on the zone.
#
# Not Convex: Convex is a reactive database with file storage and no resize or
# transcode operation, so there is nothing there to point this at.
NEXT_PUBLIC_IMAGE_RESIZE_ORIGIN=""

# RSS / scheduled polling
# Default per-feed interval (seconds) used by /api/rss/poll and /api/rss/cron.
# 43200 = twice a day, matching the "rss-poll" cadence in lib/cron-schedule. A
# feed row with its own pollInterval overrides this; keep it at or above the
# scheduled cadence unless you also mean to tighten that schedule.
RSS_POLL_INTERVAL_SECONDS=43200
# Per-run caps that keep a cron cycle inside the free-tier budget when feeds
# fall behind (these cap network egress / function-seconds, not correctness):
#   RSS_POLL_MAX_FEEDS_PER_RUN  — feeds polled per cycle (default 25)
#   THUMB_RECOVERY_MAX_NETWORK  — publisher page fetches per recovery run (default 12)
RSS_POLL_MAX_FEEDS_PER_RUN=10
THUMB_RECOVERY_MAX_NETWORK=12
# Shared secret for scheduled triggers (/api/cron, /api/rss/stream). Sent to
# cron-job.org as the `x-cron-secret` header (or `Authorization: Bearer`).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# cron-job.org scheduler — pings /api/cron?trigger=... for the heavy jobs so
# the platform stays autonomous without Inngest Cloud or Vercel Cron.
#   CRONJOB_TOKEN — cron-job.org API key (Settings -> API key, free/open source)
#   APP_URL       — base URL of the deployment cron-job.org should hit
# Sync jobs into the account with: npm run cronjob:sync
CRONJOB_TOKEN=""
APP_URL="https://connectplusapp.vercel.app"

# Redis (optional but recommended) — powers the shared settings + feed caches
# across serverless instances. Any ONE of the three formats below works:
#
#  1. Redis Cloud / local / any TCP Redis:     REDIS_URL="rediss://default:TOKEN@host:port"
#  2. Upstash REST (Redis API key pair):       UPSTASH_REDIS_REST_URL="https://...upstash.io"
#                                             UPSTASH_REDIS_REST_TOKEN="..."
#  3. Vercel KV (REST):                        KV_REST_API_URL="https://...vercel.com"
#                                             KV_REST_API_TOKEN="..."
# Without any of these the build runs fully on in-memory/DB fallbacks.

# Rate limiting (optional env overrides for src/proxy.ts)
# Format: "limit:windowMs". Key names match the tables in src/proxy.ts.
# RATE_LIMIT_SIGNIN="10:900000"
# RATE_LIMIT_UPLOAD="20:60000"
# RATE_LIMIT_DEFAULT="100:60000"

# Logging
# One of: debug | info | warn | error (default: info)
# Convex (optional but recommended) — owns the two hottest write paths
# (article views + ad impressions/clicks) so Supabase free-tier writes and
# egress go to the relational reads that actually need them. Without it the app
# falls back to Postgres for both and behaves exactly as before.
#   NEXT_PUBLIC_CONVEX_URL="https://<deployment>.convex.cloud"
#   CONVEX_DEPLOY_KEY="dev:<deployment>|<key>"   # only needed to push functions
# The nightly Inngest "hive-sweep" folds Convex view deltas back into
# Post.viewCount, so Postgres stays authoritative for ranking and display.

# AI providers (optional) — powers the Neural Mind, the studio copilot and brain
# training. These two gateways are the ONLY ones this app can route, and both
# have a free tier that needs no payment method. With neither key set the app
# runs on its deterministic builtin brains, which answer content and platform
# questions without an external model.
#   OPENROUTER_API_KEY=""   # https://openrouter.ai/keys — free ids carry a :free suffix
#   OPENCODE_API_KEY=""     # https://opencode.ai/zen  — free ids end in -free
# The model id is chosen automatically per provider and is always free; a
# non-free id stored in Admin → Settings is swapped for the free default at call
# time rather than failing (see freeOrFallback in src/lib/ai-provider.ts).
# OPENAI_API_KEY / ANTHROPIC_API_KEY are deliberately NOT listed: the gateway
# cannot route them, so setting one would enable no AI capability at all.

# Web push (optional) — delivers alerts to a closed app.
# Without BOTH halves of the VAPID pair the site still shows in-app alerts while
# a tab is open, and the bell says so plainly rather than offering a button that
# does nothing. Generate the pair with:  node scripts/generate-vapid-keys.mjs
# The public key must be prefixed NEXT_PUBLIC_ so Next inlines it into the client
# bundle; the private key must never be exposed to the browser.
#   NEXT_PUBLIC_VAPID_KEY="<public key>"
#   VAPID_PRIVATE_KEY="<private key>"
#   VAPID_SUBJECT="mailto:you@example.com"   # contact address sent to the push services

# Google OAuth (optional) — enables "Continue with Google" on sign-in/sign-up.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional) — transactional email: email-verification links and the
# status watchdog's digest. Without a key the mailer logs the message to the
# server console instead of sending, so the flow stays testable locally.
#
# The from-address MUST be on a domain verified in Resend, or every send is
# rejected with 403 "domain is not verified" (the mailer logs it and returns
# delivered:false — it never throws). Defaults to
# "connectPlus <noreply@connectplusapp.com>" when MAIL_FROM is unset.
RESEND_API_KEY=""
# MAIL_FROM="connectPlus <noreply@yourdomain.com>"

# OLD Supabase account - read-only migration source (optional). Value: postgresql://... (URL only, never shown)
LEGACY_DATABASE_URL=""

# Cloudflare edge cache (free tier) — puts Cloudflare in front of the origin so
# anonymous HTML, read-only API JSON and optimised images are answered at the
# edge. This is what keeps Vercel's Fast Origin Transfer and Fluid Active CPU
# flat: the origin function never runs on an edge HIT. Deploy with:
#   CLOUDFLARE_API_TOKEN=... CLOUDFLARE_ACCOUNT_ID=... node scripts/deploy-worker.mjs
# Workers free plan is 100k requests/day; the worker uses only the Cache API.
EDGE_URL=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare edge CRON (free tier) — the same Worker also owns the scheduled
# jobs whose staleness is user-visible: the radio metadata sweep (the source of
# the "radio degraded" warning), the livescore heartbeat, the pick refresh and
# the payment reconciliation sweep. The Cron Triggers are declared in
# workers/edge-cache/wrangler.toml and registered by scripts/deploy-worker.mjs;
# pass CRON_SECRET to that script so the worker can authenticate its pings.
# Without the secret the pings are refused (401) and those jobs go stale again —
# which is precisely the failure the edge cron exists to prevent.

# Cloudflare R2 (storage offload) — DORMANT until R2 is enabled on the account.
# R2 needs an activated subscription even to create the first bucket, so the app
# keeps using Supabase Storage until these are filled in. Once set, uploads go to
# R2 and covers are served from the edge instead of through a function.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public hostname bound to the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=""
